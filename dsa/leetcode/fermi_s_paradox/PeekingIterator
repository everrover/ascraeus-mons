package dsa.leetcode.fermi_s_paradox;

import java.util.*;

public class PeekingIterator implements Iterator<Integer> {

  /**
   * https://leetcode.com/problems/peeking-iterator/
   * 
   * This class extends an iterator to include a peek operation by caching the
   * next element, allowing the next element to be viewed without advancing the iterator.
   * 
   * TC: O(1) per operation, SC: O(1)
   * #iterator #design #medium
   */

  private final Iterator<Integer> iter;
  private Integer nextElem;
  private Integer currElem;
  private boolean hasNextElem;

  public PeekingIterator(Iterator<Integer> iterator) {
    // initialize any member here.
    this.iter = iterator;
    advance();
  }

  // Returns the next element in the iteration without advancing the iterator.
  public Integer peek() {
    if(!hasNextElem) return null;
    return nextElem;
  }

  // hasNext() and next() should behave the same as in the Iterator interface.
  // Override them if needed.
  @Override
  public Integer next() {
    if(!hasNextElem) return null;
    currElem = nextElem;
    advance();
    return currElem;
  }

  @Override
  public boolean hasNext() {
    return hasNextElem;
  }

  private void advance() {
    if (iter.hasNext()) {
      nextElem = iter.next();
      hasNextElem = true;
    } else {
      hasNextElem = false;
      nextElem = null;
    }
  }
}