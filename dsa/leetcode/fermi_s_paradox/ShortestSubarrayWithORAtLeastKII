package dsa.leetcode.fermi_s_paradox;

public class ShortestSubarrayWithORAtLeastKII {

  /**
   * https://leetcode.com/problems/shortest-subarray-with-or-at-least-k-ii/
   *
   * To find the length of the shortest subarray, maintain each subarray’s bitwise OR result.
   * The OR operation never unsets any bits and only sets new bits. Hence, use bit masks
   * to track at most 32 different results for each number. Use a binary search approach
   * to find the minimal subarray length.
   *
   * TC: O(n*log(n)) SC: O(n*32)
   * #array #bit-manipulation #sliding-window #medium
   */

  public int minimumSubarrayLength(int[] nums, int k) {
    final int N = nums.length;
    int [][]mask = new int[N][32];
    for(int i=0; i<N; i++){
      for(int j=0; j<32; j++){
        mask[i][j] = (i>0?mask[i-1][j]:0)+(((nums[i]&(1<<j)) > 0)?1:0);
      }
    }
    int res = Integer.MAX_VALUE;
    for(int i=0; i<N; i++){
      int j = find(i, mask, k);
      if(j!=Integer.MAX_VALUE) res = Math.min(i-j+1, res);
    }
    return res==Integer.MAX_VALUE?-1:res;
  }
  
  private int find(int idx, int mask[][], int k){
    int l = 0, r = idx;
    int mid = 0, res = Integer.MAX_VALUE;
    while(l<=r){
      int ored = 0;
      mid = (l+r)/2;
      for(int j=0; j<32; j++){
        if(mask[idx][j]-(mid>0?mask[mid-1][j]:0) > 0) { ored += (1<<j); }
      }
      if(ored >= k){
        res = mid;
        l=mid+1;
      }else{
        r=mid-1;
      }
    }
    return res;
  }
}