package dsa.leetcode.VallesMarineris;

import java.util.Arrays;

public class MaximumAndMinimumSumsOfAtMostSizeKSubsequences {
  
  /**
   * https://leetcode.com/problems/maximum-and-minimum-sums-of-at-most-size-k-subsequences/description/
   *
   * Sort the array. Since all subsequences are to be considered the ordering can be altered.
   * For each num, we assume it to be the smallest and largest element in the subsequence. And using 
   * combinatorics, we calculate the number of ways to choose the remaining elements.
   * 
   * TC: O(n^2) SC: O(n * k)
   * #array #dynamic-programming #sorting #combinatorics #medium
   */

   final private static long M = (int)1e9+7;
   public int minMaxSums(int[] nums, int k) {
     Arrays.sort(nums);
     long res = 0;
     long [][]ncr = new long[nums.length+1][k+1];
     ncr[0][0] = 1;
     for (int n = 1; n <= nums.length; n++) {
       ncr[n][0] = 1;
       for (int r = 1; r <= k; r++) 
         ncr[n][r] = (ncr[n - 1][r - 1] + ncr[n - 1][r]) % M;
     }
     for(int n=0; n<nums.length; n++){
       long count = 0;
       for(int r=0; r<=k-1; r++){
         if(n>=r) count = (count+ncr[n][r])%M;
       }
       // for nums[n] as largest, nums[nums.length-n-1] as smallest
       res = (res+(nums[n]+nums[nums.length-n-1])*count)%M;
     }
     return (int)res;
   }
 }
 
